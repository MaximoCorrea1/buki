    {
      "label": "TM8d the fallacy: quote the cell instead of marking it text",
      "file": "src/extension/goodreadsCsv.ts",
      "from": "  return field(FORMULA.test(value) ? `'${value}` : value);",
      "to": "  return `\"${value.replace(/\"/g, '\"\"')}\"`;"
