    {
      "label": "TM8e the ISBN is wrapped as a formula unconditionally again",
      "file": "src/extension/goodreadsCsv.ts",
      "from": "  return ISBN_SHAPE.test(isbn) ? field(`=\"${isbn}\"`) : text(isbn);",
      "to": "  return field(`=\"${isbn}\"`);"
    },
    {
      "label": "TM8f the half-fix: decline to wrap, but drop the value instead of making it safe",
      "file": "src/extension/goodreadsCsv.ts",
      "from": "  return ISBN_SHAPE.test(isbn) ? field(`=\"${isbn}\"`) : text(isbn);",
      "to": "  return ISBN_SHAPE.test(isbn) ? field(`=\"${isbn}\"`) : '';"
    },
    {
