      "from": "      text(saved.book.author),",
      "to": "      field(saved.book.author),"
    },
    {
      "label": "TM8c only = is treated as a formula, the OWASP set is trimmed",
      "file": "src/extension/goodreadsCsv.ts",
      "from": "const FORMULA = /^[=+\\-@\\t\\r]/;",
      "to": "const FORMULA = /^[=]/;"
