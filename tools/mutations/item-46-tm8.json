      "file": "src/extension/goodreadsCsv.ts",
      "from": "const ISBN_SHAPE = /^[0-9-]{9,16}[0-9X]$/i;",
      "to": "const ISBN_SHAPE = /^.{9,16}[0-9X\"]$/i;"
    }
  ]
}
