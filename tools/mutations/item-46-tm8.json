{
  "target": "src/extension/goodreadsCsv.test.ts",
  "mutations": [
    {
      "label": "TM8a the title goes back to a plain CSV field",
      "file": "src/extension/goodreadsCsv.ts",
      "from": "      text(saved.book.title),",
      "to": "      field(saved.book.title),"
    },
    {
      "label": "TM8b the author goes back to a plain CSV field",
